---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { CONTACT, gallery, heroImage, schemaAmenities, t, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Set on pages that must stay out of the index (e.g. 404). */
  noindex?: boolean;
  /** Only the homepage carries the LodgingBusiness + FAQPage graph. */
  structuredData?: boolean;
}

// Fonts are self-hosted from /fonts (see @font-face in global.css), so there is no
// render-blocking request to fonts.googleapis.com. The two latin subsets are preloaded.
const { locale, title, description, noindex = false, structuredData = false } = Astro.props;
const tr = t[locale];
const site = 'https://solpordearousa.com';

// Social previews need a landscape 1.91:1 crop: the source photos are portrait,
// so a raw og:image gets badly cropped by Facebook/WhatsApp.
const og = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 80,
});
const ogImage = new URL(og.src, site).href;

const alternates: Record<Locale, string> = {
  es: `${site}/`,
  en: `${site}/en/`,
  gl: `${site}/gl/`,
};
const canonical = alternates[locale];
const ogLocales: Record<Locale, string> = { es: 'es_ES', en: 'en_GB', gl: 'gl_ES' };

// First four gallery shots double as schema.org images (Google prefers several).
const schemaImages = await Promise.all(
  gallery.slice(0, 4).map((item) =>
    getImage({ src: item.image, width: 1200, format: 'jpeg', quality: 80 }).then((img) => new URL(img.src, site).href),
  ),
);

const lodging = {
  '@type': 'LodgingBusiness',
  '@id': `${site}/#lodging`,
  name: 'Solpor de Arousa',
  description,
  url: canonical,
  inLanguage: locale,
  image: [ogImage, ...schemaImages],
  telephone: CONTACT.phone,
  priceRange: '€€',
  currenciesAccepted: 'EUR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rúa Pedroso, 46',
    addressLocality: 'Vilagarcía de Arousa',
    addressRegion: 'Pontevedra',
    postalCode: '36618',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: CONTACT.coords.lat,
    longitude: CONTACT.coords.lng,
  },
  hasMap: `https://www.google.com/maps/search/?api=1&query=${CONTACT.mapsQuery}`,
  petsAllowed: false,
  numberOfRooms: 3,
  maximumAttendeeCapacity: CONTACT.capacity,
  containsPlace: {
    '@type': 'Accommodation',
    name: 'Solpor de Arousa',
    additionalType: 'https://schema.org/House',
    occupancy: {
      '@type': 'QuantitativeValue',
      maxValue: CONTACT.capacity,
      unitCode: 'C62',
    },
    numberOfBedrooms: 3,
    numberOfBathroomsTotal: 2,
  },
  amenityFeature: schemaAmenities[locale].map((name) => ({
    '@type': 'LocationFeatureSpecification',
    name,
    value: true,
  })),
};

const faqPage = {
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  inLanguage: locale,
  mainEntity: tr.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [lodging, faqPage],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="alternate" hreflang="es" href={alternates.es} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="gl" href={alternates.gl} />
    <link rel="alternate" hreflang="x-default" href={alternates.es} />

    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Solpor de Arousa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={tr.a11y.heroAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {
      (Object.keys(ogLocales) as Locale[])
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={tr.a11y.heroAlt} />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">{tr.a11y.skipToContent}</a>
    <slot />
  </body>
</html>
