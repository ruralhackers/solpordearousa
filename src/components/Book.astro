---
import { t, CONTACT, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t[locale];

const waMsg = encodeURIComponent(tr.book.whatsappMsg);
const waHref = `https://wa.me/${CONTACT.whatsapp}?text=${waMsg}`;
---

<section class="section book" id="reservar">
  <div class="container book__inner">
    <div>
      <p class="eyebrow">{tr.nav.book}</p>
      <h2 class="section-title">{tr.book.heading}</h2>
      <p class="book__body">{tr.book.body}</p>
    </div>
    <div class="book__card">
      <div class="book__price">{tr.book.price}</div>
      <p class="book__price-note">{tr.book.priceNote}</p>
      <div class="book__actions">
        <a class="btn btn--whatsapp" href={waHref} target="_blank" rel="noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.13c-.24.68-1.4 1.3-1.93 1.38-.53.08-1.02.36-3.44-.72-2.9-1.29-4.73-4.32-4.87-4.52-.14-.2-1.16-1.54-1.16-2.94s.73-2.08 1-2.37c.26-.28.58-.35.77-.35.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.82 2 .89 2.14.07.14.12.31.02.5-.09.2-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.72 1.18 1.54 1.91 1.06.94 1.95 1.24 2.23 1.38.28.14.44.12.6-.07.17-.2.69-.8.88-1.08.18-.28.37-.23.62-.14.25.09 1.6.76 1.87.9.28.14.46.21.53.32.07.12.07.66-.17 1.34Z"/></svg>
          {tr.book.whatsapp}
        </a>
        <a class="btn btn--primary" href={CONTACT.phoneHref}>{tr.book.call}</a>
      </div>
    </div>
  </div>
</section>
