---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import House from './House.astro';
import Amenities from './Amenities.astro';
import Gallery from './Gallery.astro';
import Nearby from './Nearby.astro';
import Book from './Book.astro';
import Footer from './Footer.astro';
import { t, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t[locale];
---

<Layout locale={locale} title={tr.meta.title} description={tr.meta.description}>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} />
    <House locale={locale} />
    <Amenities locale={locale} />
    <Gallery locale={locale} />
    <Nearby locale={locale} />
    <Book locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
