---
import { Image } from 'astro:assets';
import { t, CONTACT, heroImage, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t[locale];

const waMsg = encodeURIComponent(tr.book.whatsappMsg);
const waHref = `https://wa.me/${CONTACT.whatsapp}?text=${waMsg}`;
---

<section class="hero">
  <Image
    class="hero__bg"
    src={heroImage}
    widths={[640, 1024, 1536]}
    sizes="100vw"
    format="webp"
    quality={72}
    alt={tr.a11y.heroAlt}
    fetchpriority="high"
    loading="eager"
  />
  <div class="container hero__content">
    <p class="hero__eyebrow">{tr.hero.eyebrow}</p>
    <h1>{tr.hero.title}</h1>
    <p class="hero__subtitle">{tr.hero.subtitle}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={waHref} target="_blank" rel="noopener">{tr.hero.bookWhatsapp}</a>
      <a class="btn btn--ghost" href={CONTACT.phoneHref}>{tr.hero.call}</a>
    </div>
  </div>
</section>
